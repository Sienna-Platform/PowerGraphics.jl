# Generation by Fuel

```julia; echo = false
using PowerGraphics
using PowerAnalytics

results = WEAVE_ARGS["results"]
backend = WEAVE_ARGS["backend"]

plot_fuel(results; backend = backend)
```

# Reserves by Fuel

```julia; echo = false
# One stack per reserve product: up and down products must not be summed.
services = PowerAnalytics.get_reserve_services(results)
if isempty(services)
    println("No reserve results in this simulation.")
else
    for service in services
        plot_fuel(results; backend = backend, service = service)
    end
end
```
